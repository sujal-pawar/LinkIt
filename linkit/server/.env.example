# Copy this file to server/.env and fill in your own values.
#
# These power GET /api/turn-credentials, which the client calls instead of
# talking to Metered directly. Keeping the key here (server-side, no VITE_
# prefix) means it never gets bundled into client JS and never reaches the
# browser — only the short-lived TURN username/password that endpoint
# returns does. See HOW_TO_FIX_TURN.md in the repo root for signup steps.

METERED_APP_NAME=
METERED_API_KEY=

PORT=3001
