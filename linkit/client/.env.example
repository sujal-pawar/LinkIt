# Copy this file to client/.env and fill in your own values.
#
# TURN credentials are no longer configured here. The Metered account API
# key must never live in a VITE_-prefixed var (Vite bakes those into the
# public JS bundle, so anyone could read it in devtools and burn your
# quota). Set METERED_APP_NAME / METERED_API_KEY in server/.env instead —
# the client fetches short-lived TURN credentials through the server at
# GET /api/turn-credentials. See HOW_TO_FIX_TURN.md in the repo root.

# Only needed if the client and server are on different origins
# (e.g. deployed separately). Leave unset for local dev / same-origin.
VITE_SERVER_URL=

# Optional debug flag - forces all WebRTC traffic through TURN only
# (disables direct/STUN paths). Use this to test "does TURN itself work"
# in isolation. Set to "true", leave unset/false otherwise.
VITE_FORCE_RELAY=false
