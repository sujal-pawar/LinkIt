# Copy this file to client/.env and fill in your own values.
# See HOW_TO_FIX_TURN.md in the repo root for exact signup steps.

VITE_METERED_APP_NAME=
VITE_METERED_API_KEY=

# Optional debug flag - forces all WebRTC traffic through TURN only
# (disables direct/STUN paths). Use this to test "does TURN itself work"
# in isolation. Set to "true", leave unset/false otherwise.
VITE_FORCE_RELAY=false
